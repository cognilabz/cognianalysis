{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognianalysis.local/schemas/analysis-v2.schema.json",
  "title": "Cognianalysis Analysis Contract v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "analysis_kind",
    "mode",
    "repo",
    "confidence",
    "executive_decision",
    "authored_report",
    "analysis_dimensions",
    "report_design",
    "open_questions",
    "evidence_index",
    "report_quality_review"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "analysis_kind": { "const": "cognianalysis_decision_document" },
    "mode": { "enum": ["brief", "blueprint", "deep", "complete-audit"] },
    "repo": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "scope_summary", "analyzed_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "commit": { "type": "string" },
        "scope_summary": { "type": "string", "minLength": 1 },
        "analyzed_at": { "type": "string", "minLength": 1 }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["overall", "reason", "limitations"],
      "properties": {
        "overall": { "enum": ["high", "medium", "low"] },
        "reason": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array" }
      }
    },
    "executive_decision": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary", "recommended_action", "decision_options", "top_risks", "next_steps", "evidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": "string", "minLength": 1 },
        "decision_options": { "type": "array" },
        "top_risks": { "type": "array" },
        "next_steps": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence_array" }
      }
    },
    "report_design": {
      "type": "object",
      "additionalProperties": true,
      "required": ["audience", "outline_rationale", "section_strategy"],
      "properties": {
        "audience": { "type": "array" },
        "outline_rationale": { "type": "string", "minLength": 1 },
        "section_strategy": { "type": "string", "minLength": 1 },
        "omitted_or_merged_standard_sections": { "type": "array" },
        "repository_specific_categories": { "type": "array" },
        "key_reader_questions": { "type": "array" }
      }
    },
    "analysis_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["dimension_id", "label", "status", "summary"],
        "properties": {
          "dimension_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["covered", "not_applicable", "partial", "open"] },
          "summary": { "type": "string", "minLength": 1 },
          "decision_value": { "type": "string" },
          "covered_by_sections": { "type": "array" },
          "evidence": { "$ref": "#/$defs/evidence_array" }
        }
      }
    },
    "authored_report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["style", "sections"],
      "properties": {
        "style": { "type": "string", "minLength": 1 },
        "writing_model": { "type": "string" },
        "sections": { "type": "array", "minItems": 1 }
      }
    },
    "functional_view": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "system_purpose": { "type": "string" },
        "system_purpose_evidence": { "$ref": "#/$defs/evidence_array" },
        "actors": { "type": "array" },
        "capabilities": { "type": "array" },
        "user_or_system_flows": { "type": "array" },
        "business_processes": { "type": "array" },
        "business_rules": { "type": "array" },
        "e2e_flows": { "type": "array" }
      }
    },
    "technical_view": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "architecture_summary": { "type": "string" },
        "entrypoints": { "type": "array" },
        "apis_and_interfaces": { "type": "array" },
        "request_response_examples": { "type": "array" },
        "data_and_state": { "type": "array" },
        "integrations": { "type": "array" },
        "deployment_runtime": { "type": "array" },
        "data_flows": { "type": "array" },
        "dependencies": { "type": "array" },
        "technology_stack": { "type": "array" },
        "evidence": { "$ref": "#/$defs/evidence_array" }
      }
    },
    "code_quality_security": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "bugs": { "type": "array" },
        "vulnerabilities": { "type": "array" },
        "code_quality_findings": { "type": "array" },
        "scanner_findings_imported": { "type": "array" },
        "scanner_triage": { "type": "array" }
      }
    },
    "process_analysis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "test_readiness": { "type": "string" },
        "test_readiness_evidence": { "$ref": "#/$defs/evidence_array" },
        "delivery_risks": { "type": "array" },
        "observability": { "type": "array" },
        "documentation_gaps": { "type": "array" },
        "process_improvements": { "type": "array" },
        "implemented_business_processes": { "type": "array" },
        "process_flows": { "type": "array" },
        "workflow_inefficiencies": { "type": "array" },
        "optimization_opportunities": { "type": "array" }
      }
    },
    "refactoring": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_architecture_options": { "type": "array" },
        "migration_roadmap": { "type": "array" },
        "tech_stack_options": { "type": "array" },
        "quick_wins": { "type": "array" }
      }
    },
    "core_capability_coverage": { "type": "array" },
    "whole_file_thesis_trace": { "type": "object", "additionalProperties": true },
    "whole_repository_file_accounting": { "type": "object", "additionalProperties": true },
    "report_sections": { "type": "array" },
    "open_questions": { "type": "array" },
    "evidence_index": { "$ref": "#/$defs/evidence_array" },
    "report_quality_review": { "type": "object" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" },
        "snippet": { "type": "string" },
        "claim_id": { "type": "string" }
      }
    },
    "evidence_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    }
  }
}

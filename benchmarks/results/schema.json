{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognianalysis.local/schemas/benchmark-results-v2.schema.json",
  "title": "Cognianalysis Benchmark Results v2",
  "type": "object",
  "required": ["schema_version", "kind", "generated_by", "metrics", "suites"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "kind": { "enum": ["analysis_v2_golden_results", "analysis_v2_baseline_results"] },
    "generated_by": { "type": "string" },
    "metrics": {
      "type": "object",
      "required": ["fact_recall", "evidence_precision", "unsupported_claim_rate", "decision_usefulness", "time_to_first_report", "human_correction_effort", "cost_or_token_budget", "refactoring_usefulness"],
      "properties": {
        "fact_recall": { "type": ["number", "null"] },
        "evidence_precision": { "type": ["number", "null"] },
        "unsupported_claim_rate": { "type": ["number", "null"] },
        "decision_usefulness": { "type": ["number", "null"] },
        "time_to_first_report": { "type": ["number", "null"] },
        "human_correction_effort": { "type": ["number", "null"] },
        "cost_or_token_budget": { "type": ["number", "null"] },
        "refactoring_usefulness": { "type": ["number", "null"] }
      }
    },
    "suites": { "type": "array" }
  }
}
